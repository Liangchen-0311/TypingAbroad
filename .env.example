NEXT_PUBLIC_SITE_URL=https://typeabroad.com
NEXT_PUBLIC_SITE_NAME=TypeAbroad
NEXT_PUBLIC_CLOUDBASE_ENV_ID=your-cloudbase-environment-id
NEXT_PUBLIC_CLOUDBASE_REGION=ap-shanghai
NEXT_PUBLIC_CLOUDBASE_ACCESS_KEY=your-publishable-key

# Keep preview while Alipay and account APIs are under review. Preview leaves all
# practice content open. Change to live only after both APIs verify membership.
NEXT_PUBLIC_MEMBERSHIP_ACCESS_MODE=preview
NEXT_PUBLIC_ACCOUNT_API_BASE=https://typeabroad.com/api
NEXT_PUBLIC_PAYMENT_API_BASE=https://typeabroad.com/api
